rm(list = ls())

library(lme4)
library(pbkrtest)
library(ggplot2)
library(dplyr)
library(ggrepel)
library(Seurat)
library(patchwork)

d <- read.csv2('data_JR.csv')

d %>%
  group_by(Patient.name) %>%
  summarise(
    min_t = min(t, na.rm = TRUE),
    max_t = max(t, na.rm = TRUE),
    .groups = "drop")

d$t_post <- pmax(d$t, 0)

#define predictorx
vari = "area_AQP2.exp_pct"                            # All cysts harboring AQP2+ cells are considered
d$aqp2_c <- as.numeric(scale(d$area_AQP2.exp_pct))
d$aqp2 <- as.numeric(d$area_AQP2.exp_pct)

# Make results list per vari
results_list <- list()

d$aqp2_c <- as.numeric(scale(d[[vari]]))
d$aqp2 <- as.numeric(d[[vari]])

d <- d[order(d$aqp2, d$Patient.name, decreasing = T), ]
unique(d$aqp2)

d$Patient.name <- factor(d$Patient.name, levels = unique(d$Patient.name))
d$patient = d$Patient.name

# Build full model
m_full <- lmer(
  egfr ~ t + t_post + aqp2_c
  + t:aqp2_c + t_post:aqp2_c
  + (1 + t | patient),
  data = d, REML = FALSE
)
summary(m_full)
isSingular(m_full)

#tests
m_red <- update(m_full, . ~ . - t_post:aqp2_c)
anova(m_red, m_full)                       

set.seed(1)
pb_change <- PBmodcomp(m_full, m_red, nsim = 2000)
pb_change$test["PBtest", "p.value"]
fixef(m_full)["t_post:aqp2_c"]

bootstrap_output = data_frame(predictor = vari ,p.value = pb_change$test["PBtest", "p.value"], fixed.effect = fixef(m_full)["t_post:aqp2_c"])

results_list[["bootstrap.output.slope.change"]] <- as.data.frame(bootstrap_output)
results_list[["bootstrap.output.slope.change"]]

#test specificity
m_red_pre <- update(m_full, . ~ . - t:aqp2_c)
anova(m_red_pre, m_full)
set.seed(1)

pb_pre <- PBmodcomp(m_full, m_red_pre, nsim = 2000)
pb_pre$test["PBtest", "p.value"]

bootstrap_output_pre = data_frame(predictor = vari, p.value = pb_pre$test["PBtest", "p.value"])

results_list[["bootstrap.output.pre-slope"]] <- as.data.frame(bootstrap_output_pre)
results_list[["bootstrap.output.pre-slope"]]

# Leave-one-out test
patients <- levels(d$patient)
res <- data.frame(patient_left_out = patients, lrt_p = NA_real_, estimate = NA_real_)

for (p in patients) {
  m  <- update(m_full, data = droplevels(subset(d, patient != p)))
  mr <- update(m, . ~ . - t_post:aqp2_c)
  
  i <- match(p, patients)
  res$lrt_p[i] <- anova(mr, m)$`Pr(>Chisq)`[2]
  res$estimate[i] <- unname(fixef(m)["t_post:aqp2_c"])
}

results_list[["leave.one.out"]] <- as.data.frame(res)
results_list[["leave.one.out"]] 

# Individual slope change Figures
library(ggplot2)
library(dplyr)

d$pat_label <- factor(d$patient,
                      levels = levels(factor(d$patient)),
                      labels = paste0("Patient P", seq_along(levels(factor(d$patient)))))
d$period <- ifelse(d$t < 0, "pre", "post")

  slopes <- do.call(rbind, lapply(split(d, d$pat_label), function(pt){
    pre  <- coef(lm(egfr ~ t, data = subset(pt, t <  0)))["t"]
    post <- coef(lm(egfr ~ t, data = subset(pt, t >= 0)))["t"]
    data.frame(pat_label = pt$pat_label[1],
               delta     = post - pre,          # Slope change
               aqp2      = pt[[vari]][1])
  }))
  
  
  # Spearman Correlation analysis
  ct <- cor.test(slopes$aqp2, slopes$delta, method = "spearman")
  
  fig2 = ggplot(slopes, aes(x = aqp2, y = delta, label = pat_label)) +
    geom_hline(yintercept = 0, linetype = "dashed", colour = "grey60") +
    geom_point(size = 3) +
    ggrepel::geom_text_repel(size = 2) +
    geom_smooth(method = "lm", se = TRUE, colour = "steelblue") +
    labs(x = "Burden (%)",
         y = "Slope change (during − pre, mL/min/1.73m²/year)") +
    annotate("text", x = Inf, y = Inf, hjust = 2.6, vjust = 1.1,
             label = sprintf("Spearman rho = %.2f, p = %.2f",
                             ct$estimate, ct$p.value)) +
    theme_minimal(base_size = 7) 

  pdf(paste0("Slope.change_",vari,".pdf"), width = 4, height = 3)
  print(fig2)
  dev.off()

