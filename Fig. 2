# Fig 2 I-L
glucose.metabolism <-  c( "SLC2A1", "SLC2A2", "SLC2A3", "SLC2A4",             # Cellular glucose import (GLUTs)
                          "HK1", "PFKM", "PKM",                               # Glycolysis
                          "NDUFA6", "SDHC", "UQCRB", "COX4I1", "ATP5F1B")     # Oxidative Phosphorylation

fatty.acid.metabolism <- c( "CD36", "FABP1", "SLC27A2","CPT1A", "CPT2",                                                 # mitochondrial import 
                            "ACADL", "ACADM", "ACADS", "ECH1","ECHS1", "EHHADH", "HADH",  "HADHA", "HADHB", "ECI1",     # beta-oxidation
                            "NDUFA6", "SDHC", "UQCRB", "COX4I1", "ATP5F1B")                                             # Oxidative Phosphorylation

signatures = list(glucose.metabolism = glucose.metabolism,
                  fatty.acid.metabolism = fatty.acid.metabolism)

ptcd <- subset(pkd.keep, subset = celltype %in% c("PT", "CD-PC"))
ptcd.counts <- LayerData(ptcd, layer = "counts")

meta <- ptcd@meta.data[c("orig.ident", "group", "Cyst.Type", "celltype")]
meta$origin.celltype =NA
meta[meta$celltype =="PT" & meta$Cyst.Type =="Control",]$origin.celltype = "PT_Control"
meta[meta$celltype =="PT" & meta$Cyst.Type =="PT-like Cyst",]$origin.celltype = "PT-like CEC_PT-like Cyst"
meta[meta$celltype =="PT" & meta$Cyst.Type =="Mixed Cyst",]$origin.celltype = "PT-like CEC_Mixed Cyst"
meta[meta$celltype =="CD-PC" & meta$Cyst.Type =="Control",]$origin.celltype = "CD-PC_Control"
meta[meta$celltype =="CD-PC" & meta$Cyst.Type =="CD-like Cyst",]$origin.celltype = "CD-like CEC_CD-like Cyst"
meta[meta$celltype =="CD-PC" & meta$Cyst.Type =="Mixed Cyst",]$origin.celltype = "CD-like CEC_Mixed Cyst"

score_ucell <- ScoreSignatures_UCell(ptcd.counts, features = signatures)
colnames(score_ucell) <- c("Glucose.Score", "Fat.Score")
score_ucell <- as.data.frame(score_ucell)
score_ucell <- subset(score_ucell,  subset = Glucose.Score > 0 | Fat.Score > 0)

score_ucell$energy.imb = NA
score_ucell$energy.imb = (score_ucell$Glucose.Score - score_ucell$Fat.Score) / (score_ucell$Glucose.Score + score_ucell$Fat.Score)

score_ucell$total.met.score = NA
score_ucell$total.met.score = score_ucell$Glucose.Score + score_ucell$Fat.Score

meta <- meta[rownames(meta) %in% rownames(score_ucell),]
Score <- left_join(rownames_to_column(meta), rownames_to_column(score_ucell)) %>% column_to_rownames()
Score$origin.celltype <- factor(Score$origin.celltype, levels = c("PT_Control", "PT-like CEC_PT-like Cyst", "PT-like CEC_Mixed Cyst","CD-PC_Control", "CD-like CEC_CD-like Cyst", "CD-like CEC_Mixed Cyst"))

