# Description
# This R script creates cell type subsets for proximal epithelial cells, collecting duct cells, immune cells, fibroblasts, and endothelial cells

library(Seurat) 
library(tidyverse)
library(harmony)

pkd <- readRDS('/Users/johannesroeles/Library/CloudStorage/OneDrive-Persönlich/0_0_ADPKD/0_ADPKD_Reintegration and Analysis_JR/A_PKD_Integration_Final/PKD_Integrated_Final.rds')
idents.keep <- setdiff(unique(pkd@meta.data$orig.ident), c("P9Z3", "P5Z5", "P5Z4"))     # remove low quality datasets for downstream analysis
pkd <- subset(pkd, subset = orig.ident %in% idents.keep)
Idents(pkd) <- pkd@meta.data$celltype

subset.list <- list()
for (i in c("PT","CD-PC", "Fibro", "Endo")) {
  tmp <- subset(pkd, idents = i)
  tmp@meta.data <- tmp@meta.data[colnames(tmp@meta.data)[grepl("clusters", colnames(tmp@meta.data))== F]]  # remove previous clustering metadata
  
  tmp[["RNA"]] <- split(tmp[["RNA"]], f = tmp$orig.ident)
  DefaultAssay(tmp) <- "RNA"
  tmp <- NormalizeData(tmp)
  tmp <- FindVariableFeatures(tmp)
  tmp <- ScaleData(tmp, vars.to.regress = c( "percent.mt"))
  tmp <- RunPCA(tmp)
  
  set.seed(1)
  tmp <- IntegrateLayers(
    object = tmp, method = HarmonyIntegration, 
    orig.reduction = "pca", new.reduction = "harmony")
  tmp <- FindNeighbors(tmp, reduction = "harmony", dims = 1:50)
  tmp <- FindClusters(tmp, resolution = c(0.05, 0.1, 0.5), 
                      cluster.name = c("clusters.harmony.res0.05","clusters.harmony.res0.1", "clusters.harmony.res0.5"))
  tmp <- RunUMAP(tmp, reduction = "harmony", dims = 1:50, reduction.name = "umap.harmony")
  tmp <- JoinLayers(tmp)
  subset.list[[i]] <- tmp
}

