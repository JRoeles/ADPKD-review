# Description
# This R script creates cell type subsets for proximal epithelial cells, collecting duct cells, immune cells, fibroblasts, and endothelial cells

library(Seurat) 
library(tidyverse)
library(harmony)

set.seed(1)

cyst.levels = c("Control", "PT-like Cyst", "CD-like Cyst", "Mixed Cyst")

pkd <- readRDS("/PKD_Integrated_Final.rds")
idents.keep <- setdiff(unique(pkd@meta.data$orig.ident), c("P9Z3", "P5Z5", "P5Z4"))     # remove orig.idents of low quality for downstram analysis
pkd <- subset(pkd, subset = orig.ident %in% idents.keep)
Idents(pkd) <- pkd@meta.data$celltype

seeds <- data.frame(celltype = c("PT","CD-PC", "Fibro", "Endo", "Leuko", "PTCD"), seed = c(3,1,2,1,6,1))

subset.list <- list()
for (i in c("PT","CD-PC", "Fibro", "Endo")) {
  tmp <- subset(pkd, idents = i)
  tmp@meta.data <- tmp@meta.data[colnames(tmp@meta.data)[grepl("clusters", colnames(tmp@meta.data))== F]]  # remove previous clustering metadata

  tmp[["RNA"]] <- split(tmp[["RNA"]], f = tmp$patient)
  DefaultAssay(tmp) <- "RNA"
  tmp <- NormalizeData(tmp, verbose = F)
  tmp <- FindVariableFeatures(tmp, verbose = T, nfeatures = 2000)
  tmp <- ScaleData(tmp, verbose = T, vars.to.regress = c("nCount_RNA","percent.mt"))
  tmp <- RunPCA(tmp, verbose = F)
  set.seed(seeds[seeds$celltype == i,]$seed)
  tmp <- IntegrateLayers(object = tmp, method = HarmonyIntegration, orig.reduction = "pca", new.reduction = "harmony", verbose = TRUE)
  tmp <- FindNeighbors(tmp, reduction = "harmony", dims = 1:15)
  tmp <- FindClusters(tmp, resolution = c(0.05,0.1, 0.2, 0.3, 0.5, 0.8, 1))
  tmp <- RunUMAP(tmp, reduction = "harmony", dims = 1:15)
  tmp <- JoinLayers(tmp)
  
  tmp@meta.data$Cyst.Type <- factor(tmp@meta.data$Cyst.Type, levels = cyst.levels)

  subset.list[[i]] <- tmp
}

for (i in c("Leuko")) {
  tmp <- subset(pkd, idents = "Leuko")
  tmp@meta.data <- tmp@meta.data[colnames(tmp@meta.data)[grepl("clusters", colnames(tmp@meta.data))== F]]  # remove previous clustering metadata
  
  tmp[["RNA"]] <- split(tmp[["RNA"]], f = tmp$patient)
  DefaultAssay(tmp) <- "RNA"
  tmp <- NormalizeData(tmp, verbose = F)
  tmp <- FindVariableFeatures(tmp, verbose = T, nfeatures = 2000)
  tmp <- ScaleData(tmp, verbose = T, vars.to.regress = c("percent.mt"), features = rownames(tmp)) # scale all features
  tmp <- RunPCA(tmp, verbose = F)
  set.seed(seeds[seeds$celltype == i,]$seed)
  tmp <- IntegrateLayers(object = tmp, method = HarmonyIntegration, orig.reduction = "pca", new.reduction = "harmony", verbose = TRUE)
  tmp <- FindNeighbors(tmp, reduction = "harmony", dims = 1:30)
  tmp <- FindClusters(tmp, resolution = c(0.05,0.1, 0.2, 0.3, 0.5, 0.8, 1, 1.5))
  tmp <- RunUMAP(tmp, reduction = "harmony", dims = 1:30)
  tmp <- JoinLayers(tmp)
  
  tmp@meta.data$Cyst.Type <- factor(tmp@meta.data$Cyst.Type, levels = cyst.levels)

  subset.list[[i]] <- tmp
}

for (i in c("PTCD")) {
  tmp <- subset(pkd, subset = celltype %in% c("PT", "CD-PC"))
  tmp@meta.data <- tmp@meta.data[colnames(tmp@meta.data)[grepl("clusters", colnames(tmp@meta.data))== F]]  # remove previous clustering metadata
  
  tmp[["RNA"]] <- split(tmp[["RNA"]], f = tmp$patient)
  DefaultAssay(tmp) <- "RNA"
  tmp <- NormalizeData(tmp, verbose = F)
  tmp <- FindVariableFeatures(tmp, verbose = T, nfeatures = 2000)
  tmp <- ScaleData(tmp, verbose = T, vars.to.regress = c("nCount_RNA","percent.mt")) 
  tmp <- RunPCA(tmp, verbose = F)
  tmp <- IntegrateLayers(object = tmp, method = HarmonyIntegration, orig.reduction = "pca", new.reduction = "harmony", verbose = TRUE)
  tmp <- FindNeighbors(tmp, reduction = "harmony", dims = 1:dims)
  tmp <- FindClusters(tmp, resolution = c(0.05,0.1, 0.2, 0.3, 0.5, 0.8, 1))
  tmp <- RunUMAP(tmp, reduction = "harmony", dims = 1:dims)
  tmp <- JoinLayers(tmp)
  
  tmp@meta.data$Cyst.Type <- factor(tmp@meta.data$Cyst.Type, levels = cyst.levels)
  
  subset.list[[i]] <- tmp
}

