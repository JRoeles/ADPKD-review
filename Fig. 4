genes.list <- list(ROS.genes = ROS.genes,
                   defense.genes = defense.genes,
                   adcy.genes = adcy.genes, 
                   pde.genes = pde.genes, 
                   abcc.genes = abcc.genes,
                   solute.water.genes = solute.water.genes)

background.pt <- annotate("rect", xmin = 0, xmax = 3.5, ymin = 0, ymax = 6.5, alpha = .08, fill="mediumorchid") 
background.cd <- annotate("rect", xmin = 3.5, xmax = 7, ymin = 0, ymax = 6.5, alpha = .08, fill="green4") 

theme_fig4 <- 
  theme(plot.title = element_text(size=35, face="bold", margin = margin(b=50)), 
        axis.text.x = element_text(size=18, angle=90), 
        axis.text.y = element_text(size=18), 
        axis.title.x = element_blank(), 
        axis.title.y = element_text(size=17)) + 
  NoLegend()

plot.list <- list()

for (i in names(genes.list)) {
  
  plot.list[[i]] <- 
    VlnPlot(pkd, 
            features = c(genes.list[[i]]), 
            group.by = "celltype2_cyst.type", 
            idents = c("PT","CD-PC"), 
            log = T, 
            ncol = length(genes.list[[i]]), 
            alpha = 0.1, 
            cols = c("lightblue3","mediumorchid","burlywood2","lightblue3","green4","burlywood2")) & 
    stat_summary(fun = mean, 
                 geom = 'bar', 
                 position = position_dodge(width = 0.9), 
                 alpha = 0.8) &
    background.pt & 
    background.cd &
    theme_fig4
}

