#### Adjusted p-values for Fig 4 genes in normalized counts matrix
tmp <- LayerData(pkd, layer = "data") %>% t() %>% as.data.frame()

fig4.genes <- c(ROS.genes, defense.genes, adcy.genes, pde.genes, abcc.genes, solute.water.genes)

tmp <- tmp[,fig4.genes]
tmp <- left_join(rownames_to_column(tmp), rownames_to_column(pkd@meta.data)) %>% column_to_rownames()
tmp <- dplyr::filter(tmp, celltype %in% c("PT", "CD-PC"))

# Stats bewteen celltype2_cyst.type
stat.test1 <- tibble()

my_comparisons1 <- list(
  c("PT_Control", "PT-like CECs_PT-like Cyst"), 
  c("PT-like CECs_PT-like Cyst", "PT-like CECs_Mixed Cyst"), 
  c("PT_Control","PT-like CECs_Mixed Cyst"),
  c("CD-PC_Control", "CD-like CECs_CD-like Cyst"), 
  c("CD-like CECs_CD-like Cyst", "CD-like CECs_Mixed Cyst"), 
  c("CD-PC_Control","CD-like CECs_Mixed Cyst"))

for (i in fig4.genes) {
  f <- as.formula(paste(i, "~ celltype2_cyst.type"))
  
  df <- wilcox_test(tmp, 
                    formula = f, 
                    paired = FALSE, 
                    comparisons = my_comparisons1, 
                    p.adjust.method = "bonferroni")
  
  stat.test1 <- rbind(stat.test1, df)
}

# Stats between celltype2
stat.test2 <- tibble()

my_comparisons2 <- list(c("PT-like CECs", "CD-like CECs"))

for (i in fig4.genes) {
  f <- as.formula(paste(i, "~ celltype2"))
  
  df <- tmp %>%
    wilcox_test(formula = f, 
                paired = FALSE, 
                comparisons = my_comparisons2, 
                p.adjust.method = "bonferroni")
  stat.test2 <- rbind(stat.test2, df)
}

stat.test <- rbind(stat.test1, stat.test2)
stat.test <- arrange(stat.test, .y.)
stat.test <- dplyr::rename(stat.test, Gene = .y.)

write_csv2(stat.test, "Fig.4_stat.tests.csv")

